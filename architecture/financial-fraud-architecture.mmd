    AUTH_A --> MODEL_A["SageMaker real-time endpoint\nchampion / canary model"]
    AUTH_A --> LEDGER_A["DynamoDB decision + idempotency ledger\nlocal table baseline • MRSC lab optional"]
    AUTH_A -->|stable event ID| STREAM_A["Kinesis Data Streams\nregional payment event log"]
    STREAM_A --> FLINK_A["Managed Service for Apache Flink\nvelocity windows • late events • rules"]
    FLINK_A --> FEAT_A
    FLINK_A --> ALERT_A["Risk action stream\nstep-up / review / block"]
    STREAM_A --> FH_A["Data Firehose\nretry + error prefix"]
    FH_A --> RAW_A[("S3 raw zone\nKMS + object lock policy")]
    STREAM_A --> DLQ_A["SQS quarantine / replay\npoison events + audit"]
  end

  subgraph PROD_B["Serving environment • Region B • optional resilience lab"]
    direction TB
    APIB["Amazon API Gateway\nWAF + request limits"] --> AUTH_B["Fraud decision service\nLambda • deadline • fallback policy"]
    AUTH_B --> FEAT_B["DynamoDB online features\nlocal table baseline • MREC lab optional"]
    AUTH_B --> MODEL_B["SageMaker real-time endpoint\nchampion / canary model"]
    AUTH_B --> LEDGER_B["DynamoDB decision + idempotency ledger\nlocal table baseline • MRSC lab optional"]
    AUTH_B -->|stable event ID| STREAM_B["Kinesis Data Streams\nregional payment event log"]
    STREAM_B --> FLINK_B["Managed Service for Apache Flink\nvelocity windows • late events • rules"]
    FLINK_B --> FEAT_B
    FLINK_B --> ALERT_B["Risk action stream\nstep-up / review / block"]
    STREAM_B --> FH_B["Data Firehose\nretry + error prefix"]
    FH_B --> RAW_B[("S3 raw zone\nKMS + object lock policy")]
    STREAM_B --> DLQ_B["SQS quarantine / replay\npoison events + audit"]
  end

  EDGE --> APIA
  EDGE --> APIB
  AUTH_A -->|approve / decline / step-up| PAY
  AUTH_B -->|approve / decline / step-up| PAY
  FEAT_A <-->|optional MREC lab • one writer per entity\nversioned, idempotent features| FEAT_B
  LEDGER_A <-->|optional MRSC comparison\n2 replicas + witness Region C| LEDGER_B
  FLINK_A -->|optional regional relay • origin_region loop guard\nproducer IDs + replay checkpoints| STREAM_B
  FLINK_B -->|optional regional relay • origin_region loop guard\nproducer IDs + replay checkpoints| STREAM_A

  subgraph DATA["Data/model platform • same-account baseline; split optional"]
    direction TB
    RAW_A --> ICE["Glue Spark + Apache Iceberg\nbronze → silver → gold\nCDC + dedupe + reconciliation"]
    RAW_B --> ICE
    CAT["Glue Data Catalog + Lake Formation\nrow / column grants"] --- ICE
    ICE --> ATH["Athena\nad hoc investigation"]
    ICE --> WH["Redshift Serverless\ncase analytics (optional) "]
    ICE --> TRAIN["SageMaker Pipelines\ntrain • backtest • bias / drift checks"]
    TRAIN --> REG["SageMaker Model Registry\napproval + lineage"]
    REG -->|canary + rollback gates| MODEL_A
    REG -->|canary + rollback gates| MODEL_B
    ORCH["Step Functions\nreplay • reconciliation • retraining"] --> ICE
    ORCH --> TRAIN
  end

  subgraph PLATFORM["Security, resilience, and operations • portfolio baseline and optional Regions"]
    direction TB
    SEC["Personal portfolio controls: scoped IAM • KMS • private access\nCloudTrail • GuardDuty • Security Hub • Lake Formation\nSeparate accounts are an optional advanced exercise"]
    OBS["CloudWatch + X-Ray + OpenTelemetry\nlatency / fraud recall / false-positive / lag SLOs"]
    BUS["EventBridge incident bus → SNS / PagerDuty\nDLQ age • model fallback • replication lag • Flink checkpoints"]
    CICD["CI/CD with OIDC + Terraform\nunit / replay / load / chaos tests\nblue-green Flink + model deployment"]
    SEC --- OBS --- BUS
    CICD --- SEC
  end

