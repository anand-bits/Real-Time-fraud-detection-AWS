flowchart LR
  PAY["Payment networks / merchant apps\nTokenized payment events"] --> EDGE["AWS Global Accelerator + Route 53\nhealth checks, region steering"]

  subgraph PROD_A["Serving environment • Region A • single-Region baseline"]
    direction TB
    APIA["Amazon API Gateway\nWAF + request limits"] --> AUTH_A["Fraud decision service\nLambda • deadline • fallback policy"]
