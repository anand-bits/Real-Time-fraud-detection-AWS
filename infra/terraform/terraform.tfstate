            "id": "749199907",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"ReadAndWriteProjectBucket\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:ListBucketMultipartUploads\",\n        \"s3:ListBucket\",\n        \"s3:GetBucketLocation\"\n      ],\n      \"Resource\": \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2\",\n      \"Condition\": {\n        \"StringLike\": {\n          \"s3:prefix\": [\n            \"raw/*\",\n            \"silver/*\",\n            \"curated/iceberg/*\",\n            \"gold/*\",\n            \"quarantine/*\",\n            \"ops/*\",\n            \"tmp/glue/*\",\n            \"ml/training_exports/glue/*\",\n            \"artifacts/glue/*\"\n          ]\n        }\n      }\n    },\n    {\n      \"Sid\": \"ReadSourceAndLakehouseData\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:GetObject\",\n      \"Resource\": [\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/silver/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/raw/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ops/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/gold/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/curated/iceberg/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/artifacts/glue/*\"\n      ]\n    },\n    {\n      \"Sid\": \"WriteProjectOutputs\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:ListMultipartUploadParts\",\n        \"s3:AbortMultipartUpload\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/tmp/glue/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/silver/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/quarantine/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ops/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/training_exports/glue/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/gold/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/curated/iceberg/*\"\n      ]\n    },\n    {\n      \"Sid\": \"RemoveRewrittenOutputObjects\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:DeleteObject\",\n      \"Resource\": [\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/tmp/glue/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/silver/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ops/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/training_exports/glue/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/gold/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/curated/iceberg/*\"\n      ]\n    },\n    {\n      \"Sid\": \"UseBucketEncryptionKey\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kms:ReEncryptTo\",\n        \"kms:ReEncryptFrom\",\n        \"kms:GenerateDataKey\",\n        \"kms:Encrypt\",\n        \"kms:DescribeKey\",\n        \"kms:Decrypt\"\n      ],\n      \"Resource\": \"arn:aws:kms:ap-southeast-2:908768512617:key/687b23a3-9a0e-4d06-a551-3fc0cb60d5ee\"\n    },\n    {\n      \"Sid\": \"ReadAndCommitGlueCatalogTables\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"glue:UpdateTable\",\n        \"glue:GetTables\",\n        \"glue:GetTable\",\n        \"glue:GetPartitions\",\n        \"glue:GetPartition\",\n        \"glue:GetDatabases\",\n        \"glue:GetDatabase\",\n        \"glue:GetCatalog\",\n        \"glue:BatchGetPartition\"\n      ],\n      \"Resource\": [\n        \"arn:aws:glue:ap-southeast-2:908768512617:table/sentinelpay/*\",\n        \"arn:aws:glue:ap-southeast-2:908768512617:database/sentinelpay\",\n        \"arn:aws:glue:ap-southeast-2:908768512617:catalog\"\n      ]\n    },\n    {\n      \"Sid\": \"WriteGlueJobLogsAndMetrics\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"logs:PutLogEvents\",\n        \"logs:CreateLogStream\",\n        \"logs:CreateLogGroup\",\n        \"cloudwatch:PutMetricData\"\n      ],\n      \"Resource\": \"*\"\n    }\n  ]\n}",
