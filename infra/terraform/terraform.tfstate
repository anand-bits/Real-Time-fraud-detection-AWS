            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"ListTrainingInputsAndOutputs\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:ListBucket\",\n        \"s3:GetBucketLocation\"\n      ],\n      \"Resource\": \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2\",\n      \"Condition\": {\n        \"StringLike\": {\n          \"s3:prefix\": [\n            \"ops/glue_batch_runs/*\",\n            \"ml/training_exports/glue/*\",\n            \"ml/models/*\"\n          ]\n        }\n      }\n    },\n    {\n      \"Sid\": \"ReadGlueManifestsAndParquetSplits\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:GetObject\",\n      \"Resource\": [\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ops/glue_batch_runs/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/training_exports/glue/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/models/locks/*\"\n      ]\n    },\n    {\n      \"Sid\": \"WriteVersionedModelArtifacts\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:PutObject\",\n      \"Resource\": \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/models/*\"\n    },\n    {\n      \"Sid\": \"ReleaseExpiredTrainingLocks\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:DeleteObject\",\n      \"Resource\": \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/models/locks/*\"\n    },\n    {\n      \"Sid\": \"UseProjectS3EncryptionKey\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kms:GenerateDataKey\",\n        \"kms:Encrypt\",\n        \"kms:DescribeKey\",\n        \"kms:Decrypt\"\n      ],\n      \"Resource\": \"arn:aws:kms:ap-southeast-2:908768512617:key/687b23a3-9a0e-4d06-a551-3fc0cb60d5ee\"\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"ListTrainingInputsAndOutputs\",\"Effect\":\"Allow\",\"Action\":[\"s3:ListBucket\",\"s3:GetBucketLocation\"],\"Resource\":\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2\",\"Condition\":{\"StringLike\":{\"s3:prefix\":[\"ops/glue_batch_runs/*\",\"ml/training_exports/glue/*\",\"ml/models/*\"]}}},{\"Sid\":\"ReadGlueManifestsAndParquetSplits\",\"Effect\":\"Allow\",\"Action\":\"s3:GetObject\",\"Resource\":[\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ops/glue_batch_runs/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/training_exports/glue/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/models/locks/*\"]},{\"Sid\":\"WriteVersionedModelArtifacts\",\"Effect\":\"Allow\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/models/*\"},{\"Sid\":\"ReleaseExpiredTrainingLocks\",\"Effect\":\"Allow\",\"Action\":\"s3:DeleteObject\",\"Resource\":\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/models/locks/*\"},{\"Sid\":\"UseProjectS3EncryptionKey\",\"Effect\":\"Allow\",\"Action\":[\"kms:GenerateDataKey\",\"kms:Encrypt\",\"kms:DescribeKey\",\"kms:Decrypt\"],\"Resource\":\"arn:aws:kms:ap-southeast-2:908768512617:key/687b23a3-9a0e-4d06-a551-3fc0cb60d5ee\"}]}",
