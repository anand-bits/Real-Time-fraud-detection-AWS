      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "3066266465",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"ReadAndWriteProjectBucket\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:ListBucketMultipartUploads\",\n        \"s3:ListBucket\",\n        \"s3:GetBucketLocation\"\n      ],\n      \"Resource\": \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2\",\n      \"Condition\": {\n        \"StringLike\": {\n          \"s3:prefix\": [\n            \"raw/*\",\n            \"silver/*\",\n            \"gold/*\",\n            \"quarantine/*\",\n            \"ops/*\",\n            \"tmp/glue/*\",\n            \"ml/training_exports/glue/*\",\n            \"artifacts/glue/*\"\n          ]\n        }\n      }\n    },\n    {\n      \"Sid\": \"ReadSourceAndLakehouseData\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:GetObject\",\n      \"Resource\": [\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/silver/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/raw/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/gold/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/artifacts/glue/*\"\n      ]\n    },\n    {\n      \"Sid\": \"WriteProjectOutputs\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:ListMultipartUploadParts\",\n        \"s3:AbortMultipartUpload\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/tmp/glue/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/silver/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/quarantine/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ops/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/training_exports/glue/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/gold/*\"\n      ]\n    },\n    {\n      \"Sid\": \"RemoveRewrittenOutputObjects\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:DeleteObject\",\n      \"Resource\": [\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/tmp/glue/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/silver/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ops/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/training_exports/glue/*\",\n        \"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/gold/*\"\n      ]\n    },\n    {\n      \"Sid\": \"UseBucketEncryptionKey\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kms:ReEncryptTo\",\n        \"kms:ReEncryptFrom\",\n        \"kms:GenerateDataKey\",\n        \"kms:Encrypt\",\n        \"kms:DescribeKey\",\n        \"kms:Decrypt\"\n      ],\n      \"Resource\": \"arn:aws:kms:ap-southeast-2:908768512617:key/687b23a3-9a0e-4d06-a551-3fc0cb60d5ee\"\n    },\n    {\n      \"Sid\": \"ReadAndCommitGlueCatalogTables\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"glue:UpdateTable\",\n        \"glue:GetTables\",\n        \"glue:GetTable\",\n        \"glue:GetPartitions\",\n        \"glue:GetPartition\",\n        \"glue:GetDatabases\",\n        \"glue:GetDatabase\",\n        \"glue:GetCatalog\",\n        \"glue:BatchGetPartition\"\n      ],\n      \"Resource\": [\n        \"arn:aws:glue:ap-southeast-2:908768512617:table/sentinelpay/*\",\n        \"arn:aws:glue:ap-southeast-2:908768512617:database/sentinelpay\",\n        \"arn:aws:glue:ap-southeast-2:908768512617:catalog\"\n      ]\n    },\n    {\n      \"Sid\": \"WriteGlueJobLogsAndMetrics\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"logs:PutLogEvents\",\n        \"logs:CreateLogStream\",\n        \"logs:CreateLogGroup\",\n        \"cloudwatch:PutMetricData\"\n      ],\n      \"Resource\": \"*\"\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"ReadAndWriteProjectBucket\",\"Effect\":\"Allow\",\"Action\":[\"s3:ListBucketMultipartUploads\",\"s3:ListBucket\",\"s3:GetBucketLocation\"],\"Resource\":\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2\",\"Condition\":{\"StringLike\":{\"s3:prefix\":[\"raw/*\",\"silver/*\",\"gold/*\",\"quarantine/*\",\"ops/*\",\"tmp/glue/*\",\"ml/training_exports/glue/*\",\"artifacts/glue/*\"]}}},{\"Sid\":\"ReadSourceAndLakehouseData\",\"Effect\":\"Allow\",\"Action\":\"s3:GetObject\",\"Resource\":[\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/silver/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/raw/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/gold/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/artifacts/glue/*\"]},{\"Sid\":\"WriteProjectOutputs\",\"Effect\":\"Allow\",\"Action\":[\"s3:PutObject\",\"s3:ListMultipartUploadParts\",\"s3:AbortMultipartUpload\"],\"Resource\":[\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/tmp/glue/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/silver/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/quarantine/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ops/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/training_exports/glue/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/gold/*\"]},{\"Sid\":\"RemoveRewrittenOutputObjects\",\"Effect\":\"Allow\",\"Action\":\"s3:DeleteObject\",\"Resource\":[\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/tmp/glue/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/silver/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ops/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/ml/training_exports/glue/*\",\"arn:aws:s3:::sentinelpay-raw-dev-908768512617-ap-southeast-2/gold/*\"]},{\"Sid\":\"UseBucketEncryptionKey\",\"Effect\":\"Allow\",\"Action\":[\"kms:ReEncryptTo\",\"kms:ReEncryptFrom\",\"kms:GenerateDataKey\",\"kms:Encrypt\",\"kms:DescribeKey\",\"kms:Decrypt\"],\"Resource\":\"arn:aws:kms:ap-southeast-2:908768512617:key/687b23a3-9a0e-4d06-a551-3fc0cb60d5ee\"},{\"Sid\":\"ReadAndCommitGlueCatalogTables\",\"Effect\":\"Allow\",\"Action\":[\"glue:UpdateTable\",\"glue:GetTables\",\"glue:GetTable\",\"glue:GetPartitions\",\"glue:GetPartition\",\"glue:GetDatabases\",\"glue:GetDatabase\",\"glue:GetCatalog\",\"glue:BatchGetPartition\"],\"Resource\":[\"arn:aws:glue:ap-southeast-2:908768512617:table/sentinelpay/*\",\"arn:aws:glue:ap-southeast-2:908768512617:database/sentinelpay\",\"arn:aws:glue:ap-southeast-2:908768512617:catalog\"]},{\"Sid\":\"WriteGlueJobLogsAndMetrics\",\"Effect\":\"Allow\",\"Action\":[\"logs:PutLogEvents\",\"logs:CreateLogStream\",\"logs:CreateLogGroup\",\"cloudwatch:PutMetricData\"],\"Resource\":\"*\"}]}",
            "override_json": null,
